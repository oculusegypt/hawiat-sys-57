{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./artifacts/sabaik-almasa/src/*"],
      "@workspace/api-client-react": ["./lib/api-client-react/src/index.ts"],
      "@workspace/api-client-react/*": ["./lib/api-client-react/src/*"],
      "@workspace/api-zod": ["./lib/api-zod/src/index.ts"],
      "@workspace/api-zod/*": ["./lib/api-zod/src/*"],
      "@workspace/db": ["./lib/db/src/index.ts"],
      "@workspace/db/*": ["./lib/db/src/*"],
      "@assets/*": ["./attached_assets/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": ["dist", "build_php"]
}
