modules = ["nodejs-20", "web", "php-8.2", "python-base-3.13"]
run = "pnpm --filter @workspace/cleanflow-services run dev"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sabaik Almasa Preview"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sabaik Platform Preview"

[[workflows.workflow]]
name = "Sabaik Almasa Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ NODE_ENV=development pnpm --filter @workspace/cleanflow-services run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Sabaik Platform Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5001 BASE_PATH=/cleanflow-platform/ NODE_ENV=development pnpm --filter @workspace/cleanflow-platform run dev"
waitForPort = 5001

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "sqlite", "swig", "undollar", "xcbuild"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19040
externalPort = 19040

[[ports]]
localPort = 19770
externalPort = 80
